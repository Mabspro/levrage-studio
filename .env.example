# Copy to .env.local and fill in before enabling email on local or Vercel.

# Resend — required for any outbound mail
RESEND_API_KEY=re_xxxxxxxxxxxxx
FROM_EMAIL=studio@levrage.studio

# Your Gmail (or any inbox) — internal alert on every form submit
NOTIFY_EMAIL=you@gmail.com

# Optional — included in high-fit / regulated auto-replies
CALENDLY_LINK=https://calendly.com/your-username/build-fit-call

# Optional — site links in templates
NEXT_PUBLIC_SITE_URL=https://levrage.studio
START_BUILD_LINK=https://levrage.studio#start-a-build
